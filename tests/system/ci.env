# Public, disposable CI fixtures; never use these values in a deployment.
REGISTRY=rutaexpress-ci
IMAGE_TAG=test
SECURITY_ENABLED=true
AZURE_AD_ISSUER_URI=http://oidc:9000
AZURE_AD_AUDIENCE=api://rutaexpress-ci
RABBITMQ_USERNAME=ci-user
RABBITMQ_PASSWORD=ci-disposable-rabbit
ORACLE_ADMIN_PASSWORD=CiAdmin12345
SHIPMENTS_DB_PASSWORD=CiShipments12345
CATALOG_DB_PASSWORD=CiCatalog12345
AUDIT_DB_PASSWORD=CiAudit12345
REPORT_DB_PASSWORD=CiReport12345
KAFKA_ENABLED=true
COMPOSE_PROFILES=ep1
RABBIT_RETRY_INITIAL_MS=200
