# Copie este archivo a infra/.env (permisos 600) y complete los valores. El .env real NO se versiona.
# Todos los compose lo leen: docker compose --env-file infra/.env -f infra/<carpeta>/compose.yml ...

# --- Imágenes (GHCR). IMAGE_TAG: commit corto o main; cada servicio puede fijar su propia etiqueta (BFF_TAG, ...)
REGISTRY=ghcr.io/henisaa
IMAGE_TAG=main

# --- Seguridad (Microsoft Entra ID)
SECURITY_ENABLED=true
AZURE_AD_ISSUER_URI=https://login.microsoftonline.com/bc307149-9a0a-45b8-9f7d-2dfc104f9a09/v2.0
AZURE_AD_AUDIENCE=api://f3136620-804c-4b15-b22d-b6fad957937e

# --- RabbitMQ (use valores propios en la nube; no se admiten guest ni los de desarrollo)
RABBITMQ_USERNAME=cambiar-usuario
RABBITMQ_PASSWORD=cambiar-clave-rabbit

# --- Oracle: una contraseña de administración y una por esquema de aplicación (sin comillas dobles)
ORACLE_ADMIN_PASSWORD=cambiar-admin-oracle
SHIPMENTS_DB_PASSWORD=cambiar-shipments
CATALOG_DB_PASSWORD=cambiar-catalog
AUDIT_DB_PASSWORD=cambiar-audit
REPORT_DB_PASSWORD=cambiar-report
# Para una base gestionada (Autonomous o RDS) indique su URL JDBC:
# DB_URL=jdbc:oracle:thin:@//<host>:1521/<servicio>

# --- Kafka (EP1). false = shipments y catalog no publican en Kafka. Para encenderlo use
#     COMPOSE_PROFILES=ep1 en el compose de apps y levante infra/kafka (necesita un EC2 de 16 GiB).
KAFKA_ENABLED=false
# COMPOSE_PROFILES=ep1

# --- Entrada pública (infra/edge)
APP_DOMAIN=app.ejemplo.cl
ORIGIN_DOMAIN=origen.ejemplo.cl
# Cabecera secreta que el API Gateway agrega al llamar a origen.<dominio>. Genérela con: openssl rand -hex 32
ORIGIN_SECRET=cambiar-secreto-origen
ACME_EMAIL=correo@ejemplo.cl
# Pruebas sin gastar el límite de Let's Encrypt: https://acme-staging-v02.api.letsencrypt.org/directory
# ACME_CA=
FRONTEND_API_BASE_URL=https://api.ejemplo.cl
MSAL_REDIRECT_URI=https://app.ejemplo.cl
ENVIRONMENT_NAME=produccion

# --- Notificaciones
NOTIFY_WAREHOUSE_EMAIL=bodega@rutaexpress.local
